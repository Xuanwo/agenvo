{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenvo-test",
  "main": "integration/entry.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm", "**/wasm"],
      "fallthrough": true,
    },
  ],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "AgenvoRelay",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgenvoRelay"],
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
    },
  ],
  "vars": {
    "ORIGIN": "https://agenvo.test",
    "ADMIN_SECRET": "test-admin-secret-not-for-production-1234567890",
  },
  "observability": {
    "enabled": false,
  },
}
